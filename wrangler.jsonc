{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dashboard-unsa-produccion",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "dashboard-unsa-produccion"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "academic-db-produccion",
			"database_id": "f29bf544-8ef5-4c38-803b-23fdc8ca6ad8"
		}
	]
}
